}

async function drawKeg(tables, fail) {
  const m2vP = points(tables.fred_inflation, "M2V");
  const m2vEl = document.getElementById("plot-m2v");
  if (m2vEl) {
    if (!m2vP.xs.length) m2vEl.innerHTML = `<p class="err">M2V missing — run fetch + process</p>`;
    else await Plotly.newPlot("plot-m2v", [{
      type: "scatter", mode: "lines", x: m2vP.xs, y: m2vP.ys, name: "M2V",
      line: { color: "#ff2bd6", width: 2 },
    }], Object.assign(layout("M2V  velocity of M2. Dashes: 2018-Q1 / 2021-Q4 / 2022-Q1"), {
      shapes: hingeShapes(), height: 320,
    }), { responsive: true, displaylogo: false });
  }
  await draw("plot-m2sl", tables.fred_inflation, { color: "#00f0ff", title: "M2SL  M2 stock ($bn)" }, "M2SL");
  await draw("plot-totll", tables.fred_financial_conditions, { color: "#c4a35a", title: "TOTLL  bank loans & leases ($bn)" }, "TOTLL");

  const m2q = qLast(tables.fred_inflation, "M2SL");
  const totq = qLast(tables.fred_financial_conditions, "TOTLL");
  const m2vq = qLast(tables.fred_inflation, "M2V");
  const igq = qLast(tables.fred_fiscal_nipa, "A091RC1Q027SBEA");
  const adjByQ = new Map();
  fail.forEach((r) => {
    const q = qid(r.date);
    const a = Number(r.rate_adjust);
    if (q && Number.isFinite(a)) adjByQ.set(q, a);
  });
  const qs = Array.from(new Set([...m2q.keys(), ...totq.keys(), ...igq.keys(), ...m2vq.keys()])).sort();
  const keg = qs.map((q) => {
    const m = m2q.get(q), t = totq.get(q), i = igq.get(q), v = m2vq.get(q);
    const m2 = m ? m.v : null, tot = t ? t.v : null, ig = i ? i.v : null, vel = v ? v.v : null;
    const date = (i || t || m || v || {}).date || q;
    return {
      q, date,
      m2, tot, ig, vel,
      sleep: (m2 != null && tot != null) ? m2 - tot : null,
      adj: adjByQ.has(q) ? adjByQ.get(q) : null,
    };
  });
  for (let i = 1; i < keg.length; i++) {
    keg[i].dIg = (keg[i].ig != null && keg[i - 1].ig != null) ? keg[i].ig - keg[i - 1].ig : null;
    keg[i].dCp = (keg[i].tot != null && keg[i - 1].tot != null) ? keg[i].tot - keg[i - 1].tot : null;
    keg[i].gap = (keg[i].dIg != null && keg[i].dCp != null) ? keg[i].dIg - keg[i].dCp : null;
  }
  const sleepEl = document.getElementById("plot-sleep");
  const sleepRows = keg.filter((r) => r.sleep != null);
  if (sleepEl) {
    if (!sleepRows.length) sleepEl.innerHTML = `<p class="err">M2SL / TOTLL missing</p>`;
    else await Plotly.newPlot("plot-sleep", [{
      type: "scatter", mode: "lines",
      x: sleepRows.map((r) => r.date), y: sleepRows.map((r) => r.sleep),
      name: "M2 − TOTLL", line: { color: "#c4a35a", width: 2 },
    }], Object.assign(layout("Sleeping stock  M2SL − TOTLL ($bn). Mixed coverage, labeled."), {
      shapes: hingeShapes(), height: 320,
    }), { responsive: true, displaylogo: false });
  }
  const igcp = keg.filter((r) => r.dIg != null && r.dCp != null);
  await Plotly.newPlot("plot-igcp", [
    {
      type: "bar", x: igcp.map((r) => r.date), y: igcp.map((r) => r.dIg),
      name: "Δ Ig (A091 SAAR $bn)", marker: { color: "rgba(255,43,214,0.7)" },
    },
    {
      type: "bar", x: igcp.map((r) => r.date), y: igcp.map((r) => r.dCp),
      name: "Δ Cp (TOTLL $bn stock)", marker: { color: "rgba(0,240,255,0.55)" },
    },
  ], Object.assign(layout("QoQ Δ. Ig is a SAAR flow; Cp is a stock. Do not net them into a theory."), {
    showlegend: true, height: 360, barmode: "group",
    shapes: hingeShapes(),
  }), { responsive: true, displaylogo: false });
  const hike = igcp.filter((r) => r.adj > 0);
  const cut = igcp.filter((r) => r.adj < 0);
  const hold = igcp.filter((r) => r.adj === 0);
  const other = igcp.filter((r) => r.adj == null);
  await Plotly.newPlot("plot-igcp-scatter", [
    { type: "scatter", mode: "markers", x: hike.map((r) => r.dIg), y: hike.map((r) => r.dCp), name: "hike",
      text: hike.map((r) => r.date), hoverinfo: "text+x+y",
      marker: { color: "#39ff14", size: 9, symbol: "triangle-up" } },
    { type: "scatter", mode: "markers", x: cut.map((r) => r.dIg), y: cut.map((r) => r.dCp), name: "cut",
      text: cut.map((r) => r.date), hoverinfo: "text+x+y",
      marker: { color: "#ff4d4d", size: 9, symbol: "triangle-down" } },
    { type: "scatter", mode: "markers", x: hold.map((r) => r.dIg), y: hold.map((r) => r.dCp), name: "hold",
      text: hold.map((r) => r.date), hoverinfo: "text+x+y",
      marker: { color: "#00f0ff", size: 7 } },
    { type: "scatter", mode: "markers", x: other.map((r) => r.dIg), y: other.map((r) => r.dCp), name: "Δ missing",
      text: other.map((r) => r.date), hoverinfo: "text+x+y",
      marker: { color: "#7f93a6", size: 6, opacity: 0.5 } },
  ], Object.assign(layout("ΔIg vs ΔCp. Green ▲ = hike quarter."), {
    showlegend: true, height: 360,
    xaxis: Object.assign({}, layout("").xaxis, { title: "Δ Ig SAAR $bn" }),
    yaxis: Object.assign({}, layout("").yaxis, { title: "Δ TOTLL $bn" }),
    shapes: [
      { type: "line", xref: "paper", x0: 0, x1: 1, y0: 0, y1: 0, line: { color: "rgba(232,246,255,0.35)", width: 1, dash: "dot" } },
      { type: "line", yref: "paper", y0: 0, y1: 1, x0: 0, x1: 0, line: { color: "rgba(232,246,255,0.35)", width: 1, dash: "dot" } },
    ],
  }), { responsive: true, displaylogo: false });

  const since2010 = keg.filter((r) => r.date >= "2010-01-01" && r.gap != null && r.adj > 0);
  const pos = since2010.filter((r) => r.gap > 0).length;
  const tally = document.getElementById("keg-tally");
  if (tally) {
    tally.innerHTML =
      `Hike quarters since 2010 with both deltas: ${since2010.length}. ` +
      `ΔIg − ΔCp > 0 in <b>${pos}</b> of them. ` +
      `That is a count, not a money-multiplier. Units differ.`;
  }
  const tb = document.querySelector("#keg-table tbody");
  if (tb) {
    const show = keg.filter((r) => r.date >= "2015-01-01");
    tb.innerHTML = show.map((r) => `<tr>
      <td>${r.date}</td>
      <td>${fmt(r.vel, 3)}</td>
      <td>${fmt(r.m2, 0)}</td>
      <td>${fmt(r.tot, 0)}</td>
      <td>${fmt(r.sleep, 0)}</td>
      <td>${fmt(r.ig, 1)}</td>
      <td>${fmt(r.dIg, 1)}</td>
      <td>${fmt(r.dCp, 1)}</td>
      <td>${fmt(r.gap, 1)}</td>
      <td>${r.adj == null ? "—" : ((r.adj > 0 ? "+" : "") + r.adj.toFixed(2))}</td>
    </tr>`).join("");
  }
}

async function main() {
  const stamp = document.getElementById("stamp");
  const res = await fetch(DATA);
  if (!res.ok) {
    stamp.innerHTML = `<span class="err">${res.status} raw_inputs.json — python scripts/build_site_data.py --process</span>`;
    return;
  }
  const pack = await res.json();
  const tables = pack.tables || {};
  stamp.textContent = `raw_inputs ${pack.generated_at || ""}`;

  const term = tables.fred_term_premium;
  const policy = tables.fred_policy_rates;
  await draw("plot-acm", term, SERIES.THREEFYTP10, "THREEFYTP10");
  await draw("plot-dgs10", policy, SERIES.DGS10, "DGS10");
  await draw("plot-dfii10", policy, SERIES.DFII10, "DFII10");
  await draw("plot-t5yifr", term, SERIES.T5YIFR, "T5YIFR");

  const labor = tables.fred_labor_output;
  const uMap = colMap(labor, "UNRATE");
  const nMap = colMap(labor, "NROU");
  const dates = Array.from(new Set([...uMap.keys(), ...nMap.keys()])).sort();
  const xs = [];
  const ys = [];
  dates.forEach((d) => {
    const n = nMap.get(d);
    const u = uMap.get(d);
    if (!Number.isFinite(n) || !Number.isFinite(u)) return;
    xs.push(d);
    ys.push(n - u);
  });
  const zeroLine = {
    shapes: [{
      type: "line", xref: "paper", x0: 0, x1: 1, y0: 0, y1: 0,
      line: { color: "rgba(232,246,255,0.35)", width: 1, dash: "dot" },
    }],
  };
  const ugapEl = document.getElementById("plot-ugap");
  if (!xs.length) {
    ugapEl.innerHTML = `<p class="err">UNRATE / NROU missing — run process</p>`;
  } else {
    await Plotly.newPlot("plot-ugap", [{
      type: "scatter",
      mode: "lines",
      x: xs,
      y: ys,
      name: "NROU − UNRATE",
      line: { color: "#00f0ff", width: 2 },
    }], Object.assign(layout("NROU − UNRATE  (pp, up = tighter)"), zeroLine),
    { responsive: true, displaylogo: false });
  }

  const pceMap = colMap(tables.fred_inflation, "PCEPI");
  const ym = {};
  pceMap.forEach((v, d) => { ym[d.slice(0, 7)] = { d, v }; });
  const pceDates = [];
  const pceYoy = [];
  const pceGap = [];
  Object.keys(ym).sort().forEach((key) => {
    const [y, m] = key.split("-").map(Number);
    const prev = `${String(y - 1).padStart(4, "0")}-${String(m).padStart(2, "0")}`;
    if (!ym[prev]) return;
    const yoy = 100 * (ym[key].v / ym[prev].v - 1);
    pceDates.push(ym[key].d);
    pceYoy.push(yoy);
    pceGap.push(yoy - 2);
  });
  const pigapEl = document.getElementById("plot-pigap");
  const yoyEl = document.getElementById("plot-pceyoy");
  if (!pceDates.length) {
    pigapEl.innerHTML = `<p class="err">PCEPI missing — run process</p>`;
    yoyEl.innerHTML = "";
  } else {
    const twoLine = {
      shapes: [{
        type: "line", xref: "paper", x0: 0, x1: 1, y0: 2, y1: 2,
        line: { color: "rgba(232,246,255,0.35)", width: 1, dash: "dot" },
      }],
    };
    await Plotly.newPlot("plot-pigap", [{
      type: "scatter", mode: "lines",
      x: pceDates, y: pceGap, name: "PCE yoy − 2",
      line: { color: "#ff2bd6", width: 2 },
    }], Object.assign(layout("PCE yoy − 2  (pp, up = above target)"), zeroLine),
    { responsive: true, displaylogo: false });
    await Plotly.newPlot("plot-pceyoy", [{
      type: "scatter", mode: "lines",
      x: pceDates, y: pceYoy, name: "PCE yoy",
      line: { color: "#c4a35a", width: 2 },
    }], Object.assign(layout("PCEPI  12-month %"), twoLine),
    { responsive: true, displaylogo: false });
  }

  let cubesFail = [];
  let cubesSustain = [];
  try {
    const cr = await fetch("data/published/cubes.json?_=" + Date.now(), { cache: "no-store" });
    if (cr.ok) {
      const cubes = await cr.json();
      cubesFail = cubes.fail || [];
      cubesSustain = cubes.sustain || [];
    }
  } catch (e) { /* join will flag */ }
  const pceByQ = lastByQ(pceDates, pceGap);
  const empByQ = lastByQ(xs, ys);
  await drawMandateJoin(cubesFail, pceByQ, empByQ);
  await drawRegime(cubesSustain, cubesFail);
  await drawBothWorse(cubesSustain, cubesFail);
  await drawKeg(tables, cubesFail);

  const policyT = tables.fred_policy_rates;
  const funds = points(policyT, "FEDFUNDS");
  const lo = points(policyT, "DFEDTARL");
  const hi = points(policyT, "DFEDTARU");
  const fomcEl = document.getElementById("plot-fomc");
  const dEl = document.getElementById("plot-delta");
  if (!funds.xs.length && !hi.xs.length) {
    fomcEl.innerHTML = `<p class="err">FEDFUNDS / DFEDTARU missing</p>`;
  } else {
    const traces = [];
    if (lo.xs.length && hi.xs.length) {
      traces.push({
        type: "scatter", mode: "lines",
        x: hi.xs.concat(lo.xs.slice().reverse()),
        y: hi.ys.concat(lo.ys.slice().reverse()),
        fill: "toself",
        fillcolor: "rgba(196,163,90,0.18)",
        line: { width: 0 },
        name: "target range",
        hoverinfo: "skip",
      });
      traces.push({
        type: "scatter", mode: "lines",
        x: hi.xs, y: hi.ys, name: "DFEDTARU",
        line: { color: "#c4a35a", width: 1.5 },
      });
    }
    traces.push({
      type: "scatter", mode: "lines",
      x: funds.xs, y: funds.ys, name: "FEDFUNDS",
      line: { color: "#00f0ff", width: 2 },
    });
    const hx = [], hy = [], cx = [], cy = [], dx = [], dy = [];
    for (let i = 1; i < hi.xs.length; i++) {
      const d = hi.ys[i] - hi.ys[i - 1];
      if (!Number.isFinite(d) || Math.abs(d) < 1e-9) continue;
      dx.push(hi.xs[i]);
      dy.push(d);
      if (d > 0) { hx.push(hi.xs[i]); hy.push(hi.ys[i]); }
      else { cx.push(hi.xs[i]); cy.push(hi.ys[i]); }
    }
    traces.push({
      type: "scatter", mode: "markers",
      x: hx, y: hy, name: "hike",
      marker: { color: "#ff2bd6", size: 8, symbol: "triangle-up" },
    });
    traces.push({
      type: "scatter", mode: "markers",
      x: cx, y: cy, name: "cut",
      marker: { color: "#39ff14", size: 8, symbol: "triangle-down" },
    });
    await Plotly.newPlot("plot-fomc", traces,
      Object.assign(layout("FOMC target range and effective funds"), { showlegend: true, height: 360 }),
      { responsive: true, displaylogo: false });
    await Plotly.newPlot("plot-delta", [{
      type: "bar",
      x: dx, y: dy, name: "Δ DFEDTARU",
      marker: { color: dy.map((v) => (v > 0 ? "#ff2bd6" : "#39ff14")) },
    }], Object.assign(layout("Month-end Δ upper bound (pp)  hike / cut"), { showlegend: false }),
    { responsive: true, displaylogo: false });
  }

  const mspdTbl = tables.fiscal_mspd_composition;
  const mixEl = document.getElementById("plot-mix3d");
  if (mixEl) {
    const buckets = [
      { col: "MSPD_BILLS_SHARE_MARKETABLE", y: 0, name: "Bills", color: "#00f0ff" },
      { col: "MSPD_NOTES_SHARE_MARKETABLE", y: 1, name: "Notes", color: "#c4a35a" },
      { col: "MSPD_BONDS_SHARE_MARKETABLE", y: 2, name: "Bonds", color: "#ff2bd6" },
      { col: "MSPD_TIPS_SHARE_MARKETABLE", y: 3, name: "TIPS", color: "#39ff14" },
      { col: "MSPD_FRN_SHARE_MARKETABLE", y: 4, name: "FRN", color: "#7aa2ff" },
    ];
    const rows = ((mspdTbl && mspdTbl.rows) || []).slice().sort((a, b) => (a.date < b.date ? -1 : 1));
    const have = buckets.some((b) => rows.some((r) => Number.isFinite(Number(r[b.col]))));
    if (!have) {
      mixEl.innerHTML = `<p class="err">MSPD class shares missing — rerun fetch + process so raw_inputs.fiscal_mspd_composition has NOTES/BONDS/TIPS/FRN shares</p>`;
    } else {
