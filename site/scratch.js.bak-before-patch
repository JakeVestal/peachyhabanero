function layout(title) {
  return {
    title: { text: title, font: { color: "#00f0ff", size: 13 } },
    paper_bgcolor: "#07080c",
    plot_bgcolor: "#0b0f16",
    font: { color: "#c8d6e5", family: "IBM Plex Mono, ui-monospace, monospace", size: 11 },
    margin: { l: 48, r: 16, t: 40, b: 36 },
    height: 320,
    xaxis: { gridcolor: "rgba(196,163,90,0.12)", zerolinecolor: "rgba(255,43,214,0.25)" },
    yaxis: { gridcolor: "rgba(196,163,90,0.12)", zerolinecolor: "rgba(255,43,214,0.25)" },
    showlegend: false,
  };
}

function rawNum(row, col) {
  const x = row[col];
  if (x === null || x === undefined || x === "") return null;
  const v = Number(x);
  return Number.isFinite(v) ? v : null;
}

function colMap(table, col) {
  const m = new Map();
  ((table && table.rows) || []).forEach((r) => {
    const v = rawNum(r, col);
    if (v !== null) m.set(r.date, v);
  });
  return m;
}

function points(table, col) {
  const rows = (table && table.rows) || [];
  const xs = [];
  const ys = [];
  rows.slice().reverse().forEach((r) => {
    const v = rawNum(r, col);
    if (v === null) return;
    // THREEFYTP10 starts 1990; earlier rows in the frame are 0-padded joins.
    if (col === "THREEFYTP10" && v === 0 && String(r.date) < "1990-01-01") return;
    if (col === "THREEFYTP10" && v === 0) return;
    xs.push(r.date);
    ys.push(v);
  });
  return { xs, ys };
}

function draw(el, table, spec, col) {
  const { xs, ys } = points(table, col);
  if (!xs.length) {
    document.getElementById(el).innerHTML =
      `<p class="err">${col} missing — run fetch + process so raw_inputs.json has the column</p>`;
    return;
  }
  return Plotly.newPlot(el, [{
    type: "scatter",
    mode: "lines",
    x: xs,
    y: ys,
    name: col,
    line: { color: spec.color, width: 2 },
  }], layout(spec.title), { responsive: true, displaylogo: false });
}

function qid(d) {
  const y = Number(String(d).slice(0, 4));
  const m = Number(String(d).slice(5, 7));
  if (!y || !m) return null;
  return y + "Q" + Math.ceil(m / 3);
}

function lastByQ(dates, values) {
  const m = new Map();
  dates.forEach((d, i) => {
    const q = qid(d);
    const v = values[i];
    if (!q || !Number.isFinite(v)) return;
    m.set(q, v);
  });
  return m;
}

function signedDist(f1, f2, f3) {
  const d = [f1, f2, f3];
  if (d.some((v) => !Number.isFinite(v))) return null;
  const short = d.map((v) => Math.max(0, -v));
  if (short.some((v) => v > 0)) return Math.hypot(short[0], short[1], short[2]);
  return -Math.min(d[0], d[1], d[2]);
}

function fmt(v, n) {
  return Number.isFinite(v) ? v.toFixed(n) : "—";
}

function log2(x) { return Math.log(x) / Math.log(2); }

function csvEscape(s) {
  const t = String(s ?? "");
  if (/[",\n]/.test(t)) return `"${t.replace(/"/g, '""')}"`;
  return t;
}

function actionInfo(rows) {
  const acts = ["hike", "hold", "cut"];
  const usable = rows.filter((r) => acts.includes(r.action));
  const N = usable.length;
  const n = { in: { hike: 0, hold: 0, cut: 0 }, out: { hike: 0, hold: 0, cut: 0 } };
  usable.forEach((r) => { n[r.inside ? "in" : "out"][r.action] += 1; });
  if (!N) {
    return {
      N: 0, n, px: { in: 0, out: 0 }, py: { hike: 0, hold: 0, cut: 0 },
      I: 0, HY: 0, chi: 0, acts,
      nIn: 0, nOut: 0,
      pHikeIn: null, pHikeOut: null, lift: null,
    };
  }
  const px = {
    in: (n.in.hike + n.in.hold + n.in.cut) / N,
    out: (n.out.hike + n.out.hold + n.out.cut) / N,
  };
  const py = {};
  acts.forEach((a) => { py[a] = (n.in[a] + n.out[a]) / N; });
  let I = 0;
  let chi = 0;
  ["in", "out"].forEach((s) => {
    acts.forEach((a) => {
      const c = n[s][a];
      if (c > 0 && px[s] > 0 && py[a] > 0) I += (c / N) * log2((c / N) / (px[s] * py[a]));
      const exp = N * px[s] * py[a];
      if (exp > 0) chi += ((c - exp) ** 2) / exp;
    });
  });
  let HY = 0;
  acts.forEach((a) => { if (py[a] > 0) HY -= py[a] * log2(py[a]); });
  const nIn = n.in.hike + n.in.hold + n.in.cut;
  const nOut = n.out.hike + n.out.hold + n.out.cut;
  const pHikeIn = nIn ? n.in.hike / nIn : null;
  const pHikeOut = nOut ? n.out.hike / nOut : null;
  const lift = (pHikeIn != null && pHikeOut != null && pHikeOut > 0) ? pHikeIn / pHikeOut : null;
  return { N, n, px, py, I, HY, chi, acts, nIn, nOut, pHikeIn, pHikeOut, lift };
}

async function drawMandateJoin(fail, pceByQ, empByQ) {
  const tally = document.getElementById("join-tally");
  const tb = document.querySelector("#join-table tbody");
  if (!fail.length) {
    if (tally) tally.innerHTML = `<span class="err">cubes.json fail[] empty</span>`;
    return;
  }
  const rows = fail.slice().sort((a, b) => (a.date < b.date ? -1 : 1)).map((r) => {
    const q = qid(r.date);
    const f1 = Number(r.F1), f2 = Number(r.F2), f3 = Number(r.F3);
    const inside = f1 > 0 && f2 > 0 && f3 > 0;
    const pce = Number.isFinite(Number(r.pce_gap)) ? Number(r.pce_gap) : (pceByQ.get(q) ?? null);
    const emp = Number.isFinite(Number(r.emp_gap)) ? Number(r.emp_gap) : (empByQ.get(q) ?? null);
    const adj = (r.rate_adjust == null || r.rate_adjust === "") ? null : Number(r.rate_adjust);
    const missing = adj == null || !Number.isFinite(adj);
    const action = missing ? "missing" : adj > 0 ? "hike" : adj < 0 ? "cut" : "hold";
    const heat = Number.isFinite(pce) && pce > 0;
    let label = "";
    if (inside && action === "hike" && heat) label = "collision: FED";
    else if (inside && action === "hike" && !heat) label = "hike, no heat";
    else if (inside && (action === "hold" || action === "cut") && heat) label = "collision: TREASURY";
    else if (inside && (action === "hold" || action === "cut") && !heat) label = "quiet inside";
    else if (inside && action === "missing") label = "inside, Δ missing";
    const rec = String(r.date).slice(0, 10) === "2018-03-31";
    return {
      date: String(r.date).slice(0, 10), q, inside, adj, action, pce, emp,
      f1, f2, f3, label, rec, dist: signedDist(f1, f2, f3),
    };
  });
  const insideRows = rows.filter((r) => r.inside);
  const fedC = insideRows.filter((r) => r.label === "collision: FED");
  const treasC = insideRows.filter((r) => r.label === "collision: TREASURY");
  const noHeat = insideRows.filter((r) => r.label === "hike, no heat");
  if (tally) {
    tally.innerHTML =
      `${rows.length} quarters · ${insideRows.length} inside · ` +
      `<b style="color:#39ff14">${fedC.length} collision: FED</b> · ` +
      `<b style="color:#ff2bd6">${treasC.length} collision: TREASURY</b> · ` +
      `${noHeat.length} hike, no heat. ` +
      `2018-Q1 is the record hike inside the box.`;
  }

  const info = actionInfo(rows);
  const mx = document.getElementById("join-matrix");
  if (mx) {
    const cell = (s, a) => info.n[s][a];
    const rowN = (s) => info.n[s].hike + info.n[s].hold + info.n[s].cut;
    const pct = (s, a) => {
      const d = rowN(s);
      return d ? `${cell(s, a)} <span style="color:#7f93a6">(${(100 * cell(s, a) / d).toFixed(0)}%)</span>` : "0";
    };
    mx.innerHTML = `
      <p class="sub" style="margin:0 0 8px">Action × box. Missing Δ dropped. Cell = count (row %).</p>
      <table class="join-mx">
        <thead><tr><th></th><th>hike</th><th>hold</th><th>cut</th><th>n</th></tr></thead>
        <tbody>
          <tr><th>inside</th><td>${pct("in","hike")}</td><td>${pct("in","hold")}</td><td>${pct("in","cut")}</td><td>${rowN("in")}</td></tr>
          <tr><th>outside</th><td>${pct("out","hike")}</td><td>${pct("out","hold")}</td><td>${pct("out","cut")}</td><td>${rowN("out")}</td></tr>
        </tbody>
      </table>`;
  }
  const miEl = document.getElementById("join-mi");
  if (miEl) {
    const share = info.HY > 0 ? (100 * info.I / info.HY) : 0;
    const fmtP = (p) => p == null ? "—" : `${(100 * p).toFixed(0)}%`;
    const hikeIn = `${info.n.in.hike}/${info.nIn}`;
    const hikeOut = `${info.n.out.hike}/${info.nOut}`;
    const liftTxt = info.lift == null ? "—" : `${info.lift.toFixed(2)}×`;
    miEl.innerHTML = `
      <div class="join-mi col-card">
        <h3>does the box inform the action?</h3>
        <p class="stat">P(hike | inside) = ${fmtP(info.pHikeIn)} &nbsp; ${hikeIn}
          &nbsp; vs &nbsp; P(hike | outside) = ${fmtP(info.pHikeOut)} &nbsp; ${hikeOut}
          &nbsp; · &nbsp; lift ${liftTxt}</p>
        <p>
          That is the claim: a quarter inside the FD box is
          ${info.lift == null ? "—" : info.lift.toFixed(2) + "×"} as likely
          to be a net hike quarter as one outside it. Counts, not a CI.
          Missing Δ dropped. Interior n = ${info.nIn}.
        </p>
        <p>I(inside; action) = <b>${info.I.toFixed(3)}</b> bits
          on H(action) = ${info.HY.toFixed(3)} bits
          (${share.toFixed(0)}% of action entropy).
          χ² = ${info.chi.toFixed(1)} (df = 2, N = ${info.N}).
          Association measure, not a forecast.
        </p>
      </div>`;
  }

  function rowClass(r) {
    if (r.rec) return "is-record";
    if (r.label === "collision: FED") return "is-collision";
    if (r.label === "collision: TREASURY") return "is-collision-treas";
    if (r.inside) return "is-inside";
    return "";
  }
  function renderTable() {
    const filt = (document.getElementById("join-filter") || {}).value || "yes";
    const shown = rows.filter((r) => {
      if (filt === "yes") return r.inside;
      if (filt === "no") return !r.inside;
      return true;
    });
    const shownEl = document.getElementById("join-shown");
    if (shownEl) shownEl.textContent = `(${shown.length} of ${rows.length})`;
    if (!tb) return;
    tb.innerHTML = shown.map((r) => `<tr class="${rowClass(r)}">
        <td>${r.date}</td>
        <td>${r.inside ? "yes" : "no"}</td>
        <td>${r.adj == null ? "—" : (r.adj > 0 ? "+" : "") + r.adj.toFixed(2)}</td>
        <td>${r.action}</td>
        <td>${fmt(r.pce, 2)}</td>
        <td>${fmt(r.emp, 2)}</td>
        <td>${fmt(r.f1, 2)}</td>
        <td>${fmt(r.f2, 2)}</td>
        <td>${fmt(r.f3, 2)}</td>
        <td>${r.rec ? "2018-Q1 RECORD · " : ""}${r.label}</td>
      </tr>`).join("");
  }
  const filtEl = document.getElementById("join-filter");
  if (filtEl) filtEl.addEventListener("change", renderTable);
  const csvBtn = document.getElementById("join-csv");
  if (csvBtn) {
    csvBtn.addEventListener("click", () => {
      const head = ["date","inside","delta_pp","action","pce_gap","emp_gap","F1","F2","F3","label","record"];
      const lines = [head.join(",")].concat(rows.map((r) => [
        r.date, r.inside ? "yes" : "no",
        r.adj == null ? "" : r.adj, r.action,
        r.pce, r.emp, r.f1, r.f2, r.f3, r.label, r.rec ? "yes" : "",
      ].map(csvEscape).join(",")));
      const blob = new Blob([lines.join("\n")], { type: "text/csv" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "fd-join.csv";
      a.click();
      URL.revokeObjectURL(a.href);
    });
  }
  renderTable();

  const mag = "#ff2bd6";
  const groups = [
    { k: "hold", color: "#00f0ff", symbol: "circle" },
    { k: "hike", color: "#39ff14", symbol: "triangle-up" },
    { k: "cut", color: "#ff4d4d", symbol: "triangle-down" },
  ];
  const scatter = groups.map((g) => {
    const xs = [], ys = [], tips = [];
    rows.forEach((r) => {
      if (r.action !== g.k || !Number.isFinite(r.pce) || !Number.isFinite(r.emp)) return;
      xs.push(r.pce);
      ys.push(r.emp);
      tips.push(
        `${r.inside ? "<b>INSIDE</b> " : ""}${r.date}  ${r.action}<br>` +
        `PCE−2 ${fmt(r.pce, 2)}  NROU−U ${fmt(r.emp, 2)}<br>` +
        `Δ ${r.adj == null ? "—" : r.adj.toFixed(2)}  ${r.label}`
      );
    });
    return {
      type: "scatter", mode: "markers", x: xs, y: ys, name: g.k,
      text: tips, hoverinfo: "text",
      marker: { color: g.color, size: g.k === "hold" ? 7 : 9, symbol: g.symbol, opacity: 0.75 },
    };
  });
  const ix = [], iy = [];
  rows.forEach((r) => {
    if (!r.inside || !Number.isFinite(r.pce) || !Number.isFinite(r.emp)) return;
    ix.push(r.pce); iy.push(r.emp);
  });
  if (ix.length) {
    scatter.push({
      type: "scatter", mode: "markers", x: ix, y: iy, name: "inside",
      hoverinfo: "skip",
      marker: { color: "rgba(0,0,0,0)", size: 12, symbol: "circle", line: { color: mag, width: 2 } },
    });
  }
  const rec = rows.find((r) => r.rec && Number.isFinite(r.pce) && Number.isFinite(r.emp));
  const annotations = rec ? [{
    x: rec.pce, y: rec.emp, text: "2018-Q1", showarrow: true,
    ax: -70, ay: 28, arrowcolor: mag, font: { color: mag, size: 11 },
    bgcolor: "rgba(7,8,12,0.82)", bordercolor: mag, borderwidth: 1,
  }] : [];
  await Plotly.newPlot("plot-join-scatter", scatter, Object.assign(layout("Mandate plane. Magenta ring = inside FD box."), {
    showlegend: true, height: 380,
    xaxis: Object.assign({}, layout("").xaxis, { title: "PCE yoy − 2 (pp)" }),
    yaxis: Object.assign({}, layout("").yaxis, { title: "NROU − UNRATE (pp)" }),
    shapes: [
      { type: "line", xref: "paper", x0: 0, x1: 1, y0: 0, y1: 0, line: { color: "rgba(232,246,255,0.35)", width: 1, dash: "dot" } },
      { type: "line", yref: "paper", y0: 0, y1: 1, x0: 0, x1: 0, line: { color: "rgba(232,246,255,0.35)", width: 1, dash: "dot" } },
    ],
    annotations,
  }), { responsive: true, displaylogo: false });

  await Plotly.newPlot("plot-join-time", [
    {
      type: "scatter", mode: "lines",
      x: rows.map((r) => r.date), y: rows.map((r) => r.pce),
      name: "PCE−2", line: { color: mag, width: 2 },
    },
    {
      type: "scatter", mode: "lines",
      x: rows.map((r) => r.date), y: rows.map((r) => r.emp),
      name: "NROU−U", line: { color: "#00f0ff", width: 2 },
    },
    {
      type: "scatter", mode: "markers",
      x: insideRows.map((r) => r.date), y: insideRows.map((r) => 0),
      name: "inside", hoverinfo: "skip",
      marker: { color: "rgba(0,0,0,0)", size: 10, symbol: "circle", line: { color: mag, width: 1.5 } },
    },
  ], Object.assign(layout("Gaps over time. Rings = interior FD quarters."), {
    showlegend: true, height: 380,
    shapes: [{ type: "line", xref: "paper", x0: 0, x1: 1, y0: 0, y1: 0, line: { color: "rgba(232,246,255,0.35)", width: 1, dash: "dot" } }],
  }), { responsive: true, displaylogo: false });
}

function qLast(table, col) {
  const m = new Map();
  ((table && table.rows) || []).forEach((r) => {
    const v = rawNum(r, col);
    const q = qid(r.date);
    if (!q || v === null) return;
    m.set(q, { date: String(r.date).slice(0, 10), v });
  });
  return m;
}

function hingeShapes() {
  const marks = [
    ["2018-03-31", "rgba(255,43,214,0.55)"],
    ["2021-12-31", "rgba(196,163,90,0.85)"],
    ["2022-03-31", "rgba(0,240,255,0.45)"],
  ];
  return marks.map(([d, c]) => ({
    type: "line", x0: d, x1: d, yref: "paper", y0: 0, y1: 1,
    line: { color: c, width: 1, dash: "dot" },
  }));
}

async function drawRegime(sustain, fail) {
  const tally = document.getElementById("regime-tally");
  const box = document.getElementById("regime-table");
  const el = document.getElementById("plot-regime");
  if (!el) return;
  const fdMap = new Map();
  fail.forEach((r) => fdMap.set(String(r.date).slice(0, 10), r));
  const rows = sustain.slice().sort((a, b) => (a.date < b.date ? -1 : 1)).map((r) => {
    const d = String(r.date).slice(0, 10);
    const f = fdMap.get(d);
    const dw = Number(r.dist_warn_rec);
    const dr = Number(r.dist_restruct_rec);
    const fd = f ? signedDist(Number(f.F1), Number(f.F2), Number(f.F3)) : null;
    return {
      date: d,
      sus: Number.isFinite(dw) ? dw : null,
      restruct: Number.isFinite(dr) ? dr : null,
      fd,
      refi: Number(r.refi_gap),
      funds: Number(r.FEDFUNDS),
      coupon: Number(r.stock_avg_coupon),
      adj: Number(r.rate_adjust),
    };
  }).filter((r) => r.sus != null || r.fd != null);
  if (!rows.length) {
    if (tally) tally.innerHTML = `<span class="err">cubes.json sustain/fail empty</span>`;
    return;
  }
  const after = rows.filter((r) => r.date >= "2021-12-31" && Number.isFinite(r.sus) && Number.isFinite(r.fd));
  let corr = null;
  if (after.length >= 6) {
    const mx = after.reduce((s, r) => s + r.sus, 0) / after.length;
    const my = after.reduce((s, r) => s + r.fd, 0) / after.length;
    let n = 0, dx = 0, dy = 0;
    after.forEach((r) => {
      const a = r.sus - mx, b = r.fd - my;
      n += a * b; dx += a * a; dy += b * b;
    });
    if (dx > 0 && dy > 0) corr = n / Math.sqrt(dx * dy);
  }
  if (tally) {
    tally.innerHTML =
      `${rows.length} quarters. Pearson(sus dist_warn, FD dist) from 2021-Q4: ` +
      `<b>${corr == null ? "n/a" : corr.toFixed(2)}</b> ` +
      `(n = ${after.length}). Negative = see-saw.`;
  }
  await Plotly.newPlot("plot-regime", [
    {
      type: "scatter", mode: "lines+markers",
      x: rows.map((r) => r.date), y: rows.map((r) => r.sus),
      name: "sus dist_warn (receipts)",
      line: { color: "#c4a35a", width: 2 }, marker: { size: 5, color: "#c4a35a" },
    },
    {
      type: "scatter", mode: "lines+markers",
      x: rows.map((r) => r.date), y: rows.map((r) => r.fd),
      name: "FD σ-distance",
      line: { color: "#ff2bd6", width: 2 }, marker: { size: 5, color: "#ff2bd6" },
    },
  ], Object.assign(layout("Inverse cubes. Gold dash = 2021-Q4 hinge."), {
    showlegend: true, height: 400,
    shapes: hingeShapes().concat([{
      type: "line", xref: "paper", x0: 0, x1: 1, y0: 0, y1: 0,
      line: { color: "rgba(232,246,255,0.35)", width: 1, dash: "dot" },
    }]),
  }), { responsive: true, displaylogo: false });
  const window = rows.filter((r) => r.date >= "2021-09-30");
  if (box) {
    box.innerHTML = `<table class="join-table"><thead><tr>
      <th>date</th><th>funds</th><th>coupon</th><th>refi</th>
      <th>sus dist_warn</th><th>FD dist</th><th>FOMC Δ</th>
    </tr></thead><tbody>${window.map((r) => `<tr>
      <td>${r.date}</td>
      <td>${fmt(r.funds, 2)}</td>
      <td>${fmt(r.coupon, 2)}</td>
      <td>${fmt(r.refi, 2)}</td>
      <td>${fmt(r.sus, 2)}</td>
      <td>${fmt(r.fd, 2)}</td>
      <td>${Number.isFinite(r.adj) ? ((r.adj > 0 ? "+" : "") + r.adj.toFixed(2)) : "—"}</td>
    </tr>`).join("")}</tbody></table>`;
  }
}

async function drawBothWorse(sustain, fail) {
  const tally = document.getElementById("both-tally");
  const fdMap = new Map();
  fail.forEach((r) => fdMap.set(String(r.date).slice(0, 10), r));
  const rows = [];
  sustain.slice().sort((a, b) => (a.date < b.date ? -1 : 1)).forEach((r) => {
    const d = String(r.date).slice(0, 10);
    const f = fdMap.get(d);
    const sus = Number(r.dist_warn_rec);
    const fd = f ? signedDist(Number(f.F1), Number(f.F2), Number(f.F3)) : null;
    if (!Number.isFinite(sus) || !Number.isFinite(fd)) return;
    rows.push({ date: d, sus, fd });
  });
  for (let i = 1; i < rows.length; i++) {
    rows[i].dSus = rows[i].sus - rows[i - 1].sus;
    rows[i].dFd = rows[i].fd - rows[i - 1].fd;
    rows[i].both = rows[i].dSus < 0 && rows[i].dFd < 0;
  }
  const both = rows.filter((r) => r.both);
  if (tally) {
    tally.innerHTML =
      `${both.length} quarters where both distances fell. ` +
      `Latest: ${both.length ? both[both.length - 1].date : "—"}. ` +
      `Post-2021-Q4: ${both.filter((r) => r.date >= "2021-12-31").length}.`;
