const DATA = "data/published/raw_inputs.json";

const SERIES = {
  THREEFYTP10: { frame: "fred_term_premium", color: "#00f0ff", title: "ACM 10y term premium (pp)" },
  DGS10:      { frame: "fred_policy_rates", color: "#c4a35a", title: "DGS10  nominal 10y (%)" },
  DFII10:     { frame: "fred_policy_rates", color: "#39ff14", title: "DFII10  10y real (%)" },
  T5YIFR:     { frame: "fred_term_premium", color: "#ff2bd6", title: "T5YIFR  5y5y inflation (%)" },
};

function layout(title) {
  return {
    title: { text: title, font: { color: "#00f0ff", size: 13 } },
    paper_bgcolor: "#07080c",
    plot_bgcolor: "#0b0f16",
    font: { color: "#c8d6e5", family: "IBM Plex Mono, ui-monospace, monospace", size: 11 },
    margin: { l: 48, r: 16, t: 40, b: 36 },
    height: 320,
    xaxis: { gridcolor: "rgba(196,163,90,0.12)", zerolinecolor: "rgba(255,43,214,0.25)" },
    yaxis: { gridcolor: "rgba(196,163,90,0.12)", zerolinecolor: "rgba(255,43,214,0.25)" },
    showlegend: false,
  };
}

function rawNum(row, col) {
  const x = row[col];
  if (x === null || x === undefined || x === "") return null;
  const v = Number(x);
  return Number.isFinite(v) ? v : null;
}

function colMap(table, col) {
  const m = new Map();
  ((table && table.rows) || []).forEach((r) => {
    const v = rawNum(r, col);
    if (v !== null) m.set(r.date, v);
  });
  return m;
}

function points(table, col) {
  const rows = (table && table.rows) || [];
  const xs = [];
  const ys = [];
  rows.slice().reverse().forEach((r) => {
    const v = rawNum(r, col);
    if (v === null) return;
    // THREEFYTP10 starts 1990; earlier rows in the frame are 0-padded joins.
    if (col === "THREEFYTP10" && v === 0 && String(r.date) < "1990-01-01") return;
    if (col === "THREEFYTP10" && v === 0) return;
    xs.push(r.date);
    ys.push(v);
  });
  return { xs, ys };
}

function draw(el, table, spec, col) {
  const { xs, ys } = points(table, col);
  if (!xs.length) {
    document.getElementById(el).innerHTML =
      `<p class="err">${col} missing — run fetch + process so raw_inputs.json has the column</p>`;
    return;
  }
  return Plotly.newPlot(el, [{
    type: "scatter",
    mode: "lines",
    x: xs,
    y: ys,
    name: col,
    line: { color: spec.color, width: 2 },
  }], layout(spec.title), { responsive: true, displaylogo: false });
}

async function main() {
  const stamp = document.getElementById("stamp");
  const res = await fetch(DATA);
  if (!res.ok) {
    stamp.innerHTML = `<span class="err">${res.status} raw_inputs.json — python scripts/build_site_data.py --process</span>`;
    return;
  }
  const pack = await res.json();
  const tables = pack.tables || {};
  stamp.textContent = `raw_inputs ${pack.generated_at || ""}`;

  const term = tables.fred_term_premium;
  const policy = tables.fred_policy_rates;
  await draw("plot-acm", term, SERIES.THREEFYTP10, "THREEFYTP10");
  await draw("plot-dgs10", policy, SERIES.DGS10, "DGS10");
  await draw("plot-dfii10", policy, SERIES.DFII10, "DFII10");
  await draw("plot-t5yifr", term, SERIES.T5YIFR, "T5YIFR");

  const labor = tables.fred_labor_output;
  const uMap = colMap(labor, "UNRATE");
  const nMap = colMap(labor, "NROU");
  const dates = Array.from(new Set([...uMap.keys(), ...nMap.keys()])).sort();
  let lastN = null;
  const xs = [];
  const ys = [];
  dates.forEach((d) => {
    if (nMap.has(d)) lastN = nMap.get(d);
    const u = uMap.get(d);
    if (lastN == null || !Number.isFinite(u)) return;
    xs.push(d);
    ys.push(lastN - u);
  });
  const zeroLine = {
    shapes: [{
      type: "line", xref: "paper", x0: 0, x1: 1, y0: 0, y1: 0,
      line: { color: "rgba(232,246,255,0.35)", width: 1, dash: "dot" },
    }],
  };
  const ugapEl = document.getElementById("plot-ugap");
  if (!xs.length) {
    ugapEl.innerHTML = `<p class="err">UNRATE / NROU missing — run process</p>`;
  } else {
    await Plotly.newPlot("plot-ugap", [{
      type: "scatter",
      mode: "lines",
      x: xs,
      y: ys,
      name: "NROU − UNRATE",
      line: { color: "#00f0ff", width: 2 },
    }], Object.assign(layout("NROU − UNRATE  (pp, up = tighter)"), zeroLine),
    { responsive: true, displaylogo: false });
  }

  const pceMap = colMap(tables.fred_inflation, "PCEPI");
  const ym = {};
  pceMap.forEach((v, d) => { ym[d.slice(0, 7)] = { d, v }; });
  const pceDates = [];
  const pceYoy = [];
  const pceGap = [];
  Object.keys(ym).sort().forEach((key) => {
    const [y, m] = key.split("-").map(Number);
    const prev = `${String(y - 1).padStart(4, "0")}-${String(m).padStart(2, "0")}`;
    if (!ym[prev]) return;
    const yoy = 100 * (ym[key].v / ym[prev].v - 1);
    pceDates.push(ym[key].d);
    pceYoy.push(yoy);
    pceGap.push(yoy - 2);
  });
  const pigapEl = document.getElementById("plot-pigap");
  const yoyEl = document.getElementById("plot-pceyoy");
  if (!pceDates.length) {
    pigapEl.innerHTML = `<p class="err">PCEPI missing — run process</p>`;
    yoyEl.innerHTML = "";
  } else {
    const twoLine = {
      shapes: [{
        type: "line", xref: "paper", x0: 0, x1: 1, y0: 2, y1: 2,
        line: { color: "rgba(232,246,255,0.35)", width: 1, dash: "dot" },
      }],
    };
    await Plotly.newPlot("plot-pigap", [{
      type: "scatter", mode: "lines",
      x: pceDates, y: pceGap, name: "PCE yoy − 2",
      line: { color: "#ff2bd6", width: 2 },
    }], Object.assign(layout("PCE yoy − 2  (pp, up = above target)"), zeroLine),
    { responsive: true, displaylogo: false });
    await Plotly.newPlot("plot-pceyoy", [{
      type: "scatter", mode: "lines",
      x: pceDates, y: pceYoy, name: "PCE yoy",
      line: { color: "#c4a35a", width: 2 },
    }], Object.assign(layout("PCEPI  12-month %"), twoLine),
    { responsive: true, displaylogo: false });
  }

  const policyT = tables.fred_policy_rates;
  const funds = points(policyT, "FEDFUNDS");
  const lo = points(policyT, "DFEDTARL");
  const hi = points(policyT, "DFEDTARU");
  const fomcEl = document.getElementById("plot-fomc");
  const dEl = document.getElementById("plot-delta");
  if (!funds.xs.length && !hi.xs.length) {
    fomcEl.innerHTML = `<p class="err">FEDFUNDS / DFEDTARU missing</p>`;
  } else {
    const traces = [];
    if (lo.xs.length && hi.xs.length) {
      traces.push({
        type: "scatter", mode: "lines",
        x: hi.xs.concat(lo.xs.slice().reverse()),
        y: hi.ys.concat(lo.ys.slice().reverse()),
        fill: "toself",
        fillcolor: "rgba(196,163,90,0.18)",
        line: { width: 0 },
        name: "target range",
        hoverinfo: "skip",
      });
      traces.push({
        type: "scatter", mode: "lines",
        x: hi.xs, y: hi.ys, name: "DFEDTARU",
        line: { color: "#c4a35a", width: 1.5 },
      });
    }
    traces.push({
      type: "scatter", mode: "lines",
      x: funds.xs, y: funds.ys, name: "FEDFUNDS",
      line: { color: "#00f0ff", width: 2 },
    });
    const hx = [], hy = [], cx = [], cy = [], dx = [], dy = [];
    for (let i = 1; i < hi.xs.length; i++) {
      const d = hi.ys[i] - hi.ys[i - 1];
      if (!Number.isFinite(d) || Math.abs(d) < 1e-9) continue;
      dx.push(hi.xs[i]);
      dy.push(d);
      if (d > 0) { hx.push(hi.xs[i]); hy.push(hi.ys[i]); }
      else { cx.push(hi.xs[i]); cy.push(hi.ys[i]); }
    }
    traces.push({
      type: "scatter", mode: "markers",
      x: hx, y: hy, name: "hike",
      marker: { color: "#ff2bd6", size: 8, symbol: "triangle-up" },
    });
    traces.push({
      type: "scatter", mode: "markers",
      x: cx, y: cy, name: "cut",
      marker: { color: "#39ff14", size: 8, symbol: "triangle-down" },
    });
    await Plotly.newPlot("plot-fomc", traces,
      Object.assign(layout("FOMC target range and effective funds"), { showlegend: true, height: 360 }),
      { responsive: true, displaylogo: false });
    await Plotly.newPlot("plot-delta", [{
      type: "bar",
      x: dx, y: dy, name: "Δ DFEDTARU",
      marker: { color: dy.map((v) => (v > 0 ? "#ff2bd6" : "#39ff14")) },
    }], Object.assign(layout("Month-end Δ upper bound (pp)  hike / cut"), { showlegend: false }),
    { responsive: true, displaylogo: false });
  }

  const mspdTbl = tables.fiscal_mspd_composition;
  const mixEl = document.getElementById("plot-mix3d");
  if (mixEl) {
    const buckets = [
      { col: "MSPD_BILLS_SHARE_MARKETABLE", y: 0, name: "Bills", color: "#00f0ff" },
      { col: "MSPD_NOTES_SHARE_MARKETABLE", y: 1, name: "Notes", color: "#c4a35a" },
      { col: "MSPD_BONDS_SHARE_MARKETABLE", y: 2, name: "Bonds", color: "#ff2bd6" },
      { col: "MSPD_TIPS_SHARE_MARKETABLE", y: 3, name: "TIPS", color: "#39ff14" },
      { col: "MSPD_FRN_SHARE_MARKETABLE", y: 4, name: "FRN", color: "#7aa2ff" },
    ];
    const rows = ((mspdTbl && mspdTbl.rows) || []).slice().sort((a, b) => (a.date < b.date ? -1 : 1));
    const have = buckets.some((b) => rows.some((r) => Number.isFinite(Number(r[b.col]))));
    if (!have) {
      mixEl.innerHTML = `<p class="err">MSPD class shares missing — rerun fetch + process so raw_inputs.fiscal_mspd_composition has NOTES/BONDS/TIPS/FRN shares</p>`;
    } else {
      const traces = buckets.map((b) => {
        const xs = [];
        const ys = [];
        const zs = [];
        rows.forEach((r) => {
          if (r[b.col] === null || r[b.col] === undefined || r[b.col] === "") return;
          const z = Number(r[b.col]);
          if (!Number.isFinite(z)) return;
          xs.push(r.date);
          ys.push(b.y);
          zs.push(z);
        });
        return {
          type: "scatter3d",
          mode: "lines+markers",
          name: b.name,
          x: xs, y: ys, z: zs,
          line: { color: b.color, width: 4 },
          marker: { size: 2, color: b.color },
        };
      });
      await Plotly.newPlot("plot-mix3d", traces, {
        title: { text: "MSPD class share of marketable (held by public)", font: { color: "#00f0ff", size: 13 } },
        paper_bgcolor: "#07080c",
        plot_bgcolor: "#0b0f16",
        font: { color: "#c8d6e5", family: "IBM Plex Mono, ui-monospace, monospace", size: 11 },
        height: 560,
        margin: { l: 0, r: 0, t: 40, b: 0 },
        scene: {
          xaxis: { title: "month", gridcolor: "rgba(196,163,90,0.2)", color: "#c8d6e5" },
          yaxis: {
            title: "class",
            tickvals: [0, 1, 2, 3, 4],
            ticktext: ["Bills", "Notes", "Bonds", "TIPS", "FRN"],
            gridcolor: "rgba(196,163,90,0.2)",
            color: "#c8d6e5",
          },
          zaxis: { title: "weight", range: [0, 1], gridcolor: "rgba(196,163,90,0.2)", color: "#c8d6e5" },
          bgcolor: "#0b0f16",
        },
        legend: { font: { color: "#c8d6e5" } },
        showlegend: true,
      }, { responsive: true, displaylogo: false });
    }
  }

  const residTbl = tables.fiscal_mspd_residual;
  const residEl = document.getElementById("plot-resid3d");
  if (residEl) {
    const buckets = [
      { col: "RESID_W_0_1Y", y: 0, name: "0–1y", color: "#00f0ff" },
      { col: "RESID_W_1_3Y", y: 1, name: "1–3y", color: "#7aa2ff" },
      { col: "RESID_W_3_7Y", y: 2, name: "3–7y", color: "#c4a35a" },
      { col: "RESID_W_7_10Y", y: 3, name: "7–10y", color: "#ffbf00" },
      { col: "RESID_W_10YPLUS", y: 4, name: "10y+", color: "#ff2bd6" },
      { col: "RESID_W_TIPS", y: 5, name: "TIPS", color: "#39ff14" },
      { col: "RESID_W_FRN", y: 6, name: "FRN", color: "#9b8cff" },
    ];
    const rows = ((residTbl && residTbl.rows) || []).slice().sort((a, b) => (a.date < b.date ? -1 : 1));
    const have = buckets.some((b) => rows.some((r) => r[b.col] !== null && r[b.col] !== "" && Number.isFinite(Number(r[b.col]))));
    if (!have) {
      residEl.innerHTML = `<p class="err">Table 3 residual weights missing — run --fetch so fiscal_mspd_residual is in the cache, then --process</p>`;
    } else {
      const traces = buckets.map((b) => {
        const xs = []; const ys = []; const zs = [];
        rows.forEach((r) => {
          if (r[b.col] === null || r[b.col] === undefined || r[b.col] === "") return;
          const z = Number(r[b.col]);
          if (!Number.isFinite(z)) return;
          xs.push(r.date); ys.push(b.y); zs.push(z);
        });
        return {
          type: "scatter3d", mode: "lines+markers", name: b.name,
          x: xs, y: ys, z: zs,
          line: { color: b.color, width: 4 },
          marker: { size: 2, color: b.color },
        };
      });
      await Plotly.newPlot("plot-resid3d", traces, {
        title: { text: "MSPD Table 3 remaining-maturity share", font: { color: "#00f0ff", size: 13 } },
        paper_bgcolor: "#07080c",
        plot_bgcolor: "#0b0f16",
        font: { color: "#c8d6e5", family: "IBM Plex Mono, ui-monospace, monospace", size: 11 },
        height: 560,
        margin: { l: 0, r: 0, t: 40, b: 0 },
        scene: {
          xaxis: { title: "month", gridcolor: "rgba(196,163,90,0.2)", color: "#c8d6e5" },
          yaxis: {
            title: "remaining",
            tickvals: [0, 1, 2, 3, 4, 5, 6],
            ticktext: ["0–1y", "1–3y", "3–7y", "7–10y", "10y+", "TIPS", "FRN"],
            gridcolor: "rgba(196,163,90,0.2)",
            color: "#c8d6e5",
          },
          zaxis: { title: "weight", range: [0, 1], gridcolor: "rgba(196,163,90,0.2)", color: "#c8d6e5" },
          bgcolor: "#0b0f16",
        },
        legend: { font: { color: "#c8d6e5" } },
        showlegend: true,
      }, { responsive: true, displaylogo: false });
    }
  }

  try {
    const cres = await fetch("data/published/cubes.json");
    if (cres.ok) {
      const cubes = await cres.json();
      const rows = (cubes.sustain || []).slice().sort((a, b) => (a.date < b.date ? -1 : 1));
      const xs = rows.map((r) => r.date);
      const mspd = rows.map((r) => Number(r.w_bills));
      const auc = rows.map((r) => Number(r.auction_bills_share));
      const refi = rows.map((r) => Number(r.refi_gap));
      const refiA = rows.map((r) => Number(r.refi_gap_auction));
      if (!auc.some(Number.isFinite)) {
        document.getElementById("plot-auction-share").innerHTML =
          "<p class=\"err\">auction_bills_share missing — rerun --process after fiscal_auctions is in cache</p>";
      } else {
        await Plotly.newPlot("plot-auction-share", [
          { type: "scatter", mode: "lines", x: xs, y: mspd, name: "MSPD bills share (published)", line: { color: "#00f0ff", width: 2 } },
          { type: "scatter", mode: "lines", x: xs, y: auc, name: "auction $ bills share", line: { color: "#ff2bd6", width: 2 } },
        ], Object.assign(layout("Bills weight  stock vs flow"), { showlegend: true }),
        { responsive: true, displaylogo: false });
        await Plotly.newPlot("plot-auction-refi", [
          { type: "scatter", mode: "lines", x: xs, y: refi, name: "refi (MSPD, published)", line: { color: "#c4a35a", width: 2 } },
          { type: "scatter", mode: "lines", x: xs, y: refiA, name: "refi (auction $)", line: { color: "#ff2bd6", width: 2 } },
        ], Object.assign(layout("Refi gap  published vs auction-weighted"), {
          showlegend: true,
          shapes: [
            { type: "line", xref: "paper", x0: 0, x1: 1, y0: 0.5, y1: 0.5, line: { color: "#ffbf00", width: 1, dash: "dot" } },
            { type: "line", xref: "paper", x0: 0, x1: 1, y0: 1, y1: 1, line: { color: "#ff2bd6", width: 1, dash: "dot" } },
          ],
        }), { responsive: true, displaylogo: false });
      }
      const marg = rows.map((r) => Number(r.marginal_rate));
      const margOld = rows.map((r) => Number(r.marginal_bills21));
      const cmp = document.getElementById("plot-marg-compare");
      if (cmp && marg.some(Number.isFinite)) {
        await Plotly.newPlot("plot-marg-compare", [
          { type: "scatter", mode: "lines", x: xs, y: margOld, name: "m  bills+2:1 (retired)", line: { color: "#c4a35a", width: 2 } },
          { type: "scatter", mode: "lines", x: xs, y: marg, name: "m  Table 3 residual (published)", line: { color: "#00f0ff", width: 2 } },
        ], Object.assign(layout("Marginal rate  retired 2:1 vs published residual"), { showlegend: true }),
        { responsive: true, displaylogo: false });
        await Plotly.newPlot("plot-refi-compare", [
          { type: "scatter", mode: "lines", x: xs, y: rows.map((r) => Number(r.refi_gap_bills21)), name: "refi  bills+2:1 (retired)", line: { color: "#c4a35a", width: 2 } },
          { type: "scatter", mode: "lines", x: xs, y: refi, name: "refi  Table 3 residual (published)", line: { color: "#00f0ff", width: 2 } },
        ], Object.assign(layout("Refi gap  published vs residual-CMT"), {
          showlegend: true,
          shapes: [
            { type: "line", xref: "paper", x0: 0, x1: 1, y0: 0.5, y1: 0.5, line: { color: "#ffbf00", width: 1, dash: "dot" } },
            { type: "line", xref: "paper", x0: 0, x1: 1, y0: 1, y1: 1, line: { color: "#ff2bd6", width: 1, dash: "dot" } },
          ],
        }), { responsive: true, displaylogo: false });
      } else if (cmp) {
        cmp.innerHTML = "<p class=\"err\">marginal_residual missing — fetch Table 3 then --process</p>";
      }
    }
  } catch (e) {
    const n = document.getElementById("plot-auction-share");
    if (n) n.innerHTML = `<p class="err">${e.message}</p>`;
  }
}

main().catch((err) => {
  document.getElementById("stamp").innerHTML = `<span class="err">${err.message}</span>`;
});
