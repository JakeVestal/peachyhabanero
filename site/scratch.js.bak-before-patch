      name: "Δ FD dist", line: { color: "#ff2bd6", width: 2 },
    },
    {
      type: "scatter", mode: "markers",
      x: both.map((r) => r.date), y: both.map((r) => r.dSus),
      name: "both worse",
      marker: { color: "#ff2bd6", size: 9, symbol: "x" },
